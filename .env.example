# Optional — the app ships with working public defaults for the hosted project.
# Set these to point at a different Supabase project.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Language calls. Both must be set on the host. Leave the model value out of git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
